[directories]
# Dropbox paths, relative to the Dropbox root
source = "/path/to/source/folder"
done = "/path/to/done/folder"

[dropbox]
# From your app at https://www.dropbox.com/developers/apps
app_key = "your_app_key"
app_secret = "your_app_secret"
# Generated with get_dropbox_token.py
refresh_token = "your_refresh_token"

[email]
smtp_host = "smtp.gmail.com"
smtp_port = 587
username = "your_gmail_address@gmail.com"
# Gmail App Password — generated at https://myaccount.google.com/apppasswords
password = "xxxx xxxx xxxx xxxx"
from_address = "your_gmail_address@gmail.com"
to_address = "billit_intake_address@my.billit.be"
subject = "Factuur"

[healthchecks]
url = "https://hc-ping.com/your-uuid-here"
